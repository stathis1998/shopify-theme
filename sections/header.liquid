<header>
  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>
</header>

{{ 'search.css' | asset_url | stylesheet_tag }}

<form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
  <div class="back-btn">&lt;</div>
  <input
    type="search"
    name="q"
    value="{{ search.terms | escape }}"
    placeholder="{{ 'search.placeholder' | t }}"
  >
  {% comment %} <button type="submit">{{ 'search.submit' | t }}</button> {% endcomment %}
</form>

{% stylesheet %}
  header {
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  header a {
    text-decoration: none;
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
