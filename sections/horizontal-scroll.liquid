<section class="py-6 full-width">
  <div
    class="overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden cursor-grab touch-pan-y scroll-px-4 px-4"
    data-hscroll
  >
    <div class="flex gap-4">
      {% if section.settings.collections and section.settings.collections.count > 0 %}
        {%- comment -%} Collections selected → show them {%- endcomment -%}
        {% for collection in section.settings.collections %}
          {% if collection %}
            <a href="{{ collection.url }}" class="block shrink-0 w-36">
              <div class="w-36 h-28 rounded-lg border border-stone-300 overflow-hidden bg-white flex items-center justify-center">
                {% if collection.image %}
                  {{
                    collection.image
                    | image_url: width: 320
                    | image_tag: alt: collection.title, loading: 'lazy', class: 'w-full h-full object-cover'
                  }}
                {% else %}
                  <i class="fa-solid fa-image text-stone-300 text-3xl"></i>
                {% endif %}
              </div>
              <div class="mt-1 text-center text-xs">{{ collection.title }}</div>
            </a>
          {% endif %}
        {% endfor %}
      {% else %}
        {%- comment -%} No collections selected → placeholders {%- endcomment -%}
        {% for i in (1..10) %}
          <div class="shrink-0 w-36">
            <div class="w-36 h-28 border border-stone-300 text-stone-300 rounded-lg snap-start flex items-center justify-center">
              <i class="fa-solid fa-image text-3xl"></i>
            </div>
            <div class="mt-1 text-center text-sm">Item {{ forloop.index }}</div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Horizontal scroll",
  "settings": [
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections"
    }
  ],
  "presets": [{ "name": "Horizontal scroll", "category": "Custom" }]
}
{% endschema %}
